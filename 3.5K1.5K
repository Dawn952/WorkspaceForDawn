    --data-parallel-rank $4 \
    --data-parallel-address $5 \
    --data-parallel-rpc-port $6 \
    --tensor-parallel-size $7 \
    --enable-expert-parallel \
    --seed 1024 \
    --quantization ascend \
    --safetensors-load-strategy 'prefetch' \
    --served-model-name kimi_k27 \
    --trust-remote-code \
    --no-enable-prefix-caching \
    --max-num-seqs 32 \
    --max-model-len 6144 \
    --max-num-batched-tokens 512 \
    --gpu-memory-utilization 0.90 \
    --enforce-eager \
    --additional-config '{"recompute_scheduler_enable":true,"eplb_config": {"dynamic_eplb": true, "expert_heat_collection_interval": 200},"ascend_compilation_config": {"enable_static_kernel": false}}' \
    --speculative-config '{"method": "dflash","model": "/mnt/weight/Kimi-K2.7-Code-DFlash", "num_speculative_tokens": 15}' \
    --kv-transfer-config \
    '{"kv_connector": "MooncakeConnectorV1",
    "kv_role": "kv_consumer",
    "kv_port": "30200",
    "engine_id": "2",
    "kv_connector_extra_config": {
                "prefill": {
                        "dp_size": 4,
                        "tp_size": 4
                },
                "decode": {
                        "dp_size": 8,
                        "tp_size": 4
                }
        }
    }' \
2>&1 | tee 2p1d_d0.log

